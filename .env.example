# =====================================================================
# DAELY REPORT STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================
# Salin file ini menjadi '.env.local' untuk pengembangan lokal atau
# atur variabel ini di panel environment hosting produksi (seperti Vercel).
# =====================================================================

# ---------------------------------------------------------------------
# 1. SUPABASE INFRASTRUCTURE (WAJIB)
# ---------------------------------------------------------------------
# Dapatkan kredensial ini di dashboard Supabase:
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Service Role Key (SANGAT RAHASIA - HANYA DI RUNTIME SERVER)
# Diperlukan untuk mengakses konfigurasi terproteksi dan bypass RLS di sisi server.
# JANGAN PERNAH menambahkan prefix NEXT_PUBLIC_ pada variabel ini.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ---------------------------------------------------------------------
# 2. AI ENGINE CONFIGURATION (SERVER-SIDE)
# ---------------------------------------------------------------------
# Pilihan provider yang didukung: 'gemini' (Google) atau 'groq' (GroqCloud)
AI_PROVIDER=gemini

# Model yang direkomendasikan:
# - Gemini: 'gemini-2.5-flash', 'gemini-1.5-flash'
# - Groq: 'llama-3.1-8b-instant', 'llama-3.3-70b-versatile'
AI_MODEL=gemini-2.5-flash

# API Key untuk provider AI yang dipilih
# - Google AI Studio: https://aistudio.google.com/
# - Groq Cloud Console: https://console.groq.com/
AI_API_KEY=your-ai-api-key-here

# ---------------------------------------------------------------------
# 3. BRANDING & NOTIFICATION SETTINGS (OPSIONAL / WHITE-LABEL)
# ---------------------------------------------------------------------
# Alamat email penerima notifikasi saat orang tua mengirimkan masukan di portal publik
NEXT_PUBLIC_BRANCH_ADMIN_EMAIL=admin@yourcourse.com

# Nama instansi / merek aplikasi yang tampil di dashboard & judul halaman
NEXT_PUBLIC_APP_NAME="Daely Report"
